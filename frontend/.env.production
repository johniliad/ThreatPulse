# Production environment.
#
# The static build is deployed next to the PHP API on the same origin, so the
# API is consumed with a relative path. No secrets and no host-specific
# credentials are required by the frontend.
#
# If the dashboard is ever deployed under a sub-path or on another host, set
# the absolute API base URL here instead.
VITE_API_BASE_URL=/api/cti/v1/
