{
  "name": "threatpulse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ThreatPulse — Transparent Cyber Threat Intelligence dashboard (static React + Vite frontend for the public CTI API).",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-sitemap.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:api": "node ../api-tests/verify-api.mjs",
    "verify:api:live": "node ../api-tests/verify-api.mjs --base https://threatpulse.iliadis.net/api/cti/v1/"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
