# ThreatPulse — static frontend (React + Vite) deployed on Apache / cPanel.
#
# The PHP API lives in /api/cti/v1/ and is served by PHP directly: it must
# never be rewritten to index.html. Its security headers are set in
# api/.htaccess, which overrides the values below for that tree.

# No directory listings: anything that would otherwise list a folder answers
# 403 instead, so a guessed directory name reveals nothing.
Options -Indexes

# ---------------------------------------------------------------------------
# CLOUDFLARE-ONLY ACCESS — always-on requirement.
# See deployment/ORIGIN_RESTRICTION.md.
#
# Cloudflare injects X-Origin-Secret on every request it forwards to this
# origin, using a Transform Rule ("Set static", which overwrites any value the
# visitor sent, so a client cannot supply its own). A request that arrives
# without the exact value did not come through Cloudflare and is refused here,
# before the SPA rewrite below can run.
#
# The value compared below is a build-time placeholder. It is replaced by
# deployment/stamp-origin-secret.mjs, which writes the stamped copy into
# dist/.htaccess; this tracked file always keeps the placeholder. A hex value
# here means the stamp went to the wrong file and the build is wrong.
#
# Deliberately OUTSIDE <IfModule mod_rewrite.c>: mod_rewrite is present on this
# host, and a guard would turn a missing module into an open site instead of a
# 500. A security control fails closed — the same reasoning as api/.htaccess.
#
# The ACME challenge path is exempt so cPanel AutoSSL can validate the domain
# without being routed through Cloudflare. It serves nothing worth hiding.
# ---------------------------------------------------------------------------
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP:X-Origin-Secret} !^__CF_ORIGIN_SECRET__$
RewriteRule ^ - [F,L]

# Apache's shipped configuration already denies .ht* files; stating the rule
# here makes the guarantee local to this file rather than inherited from the
# host. The (?!well-known) lookahead keeps the ACME path reachable, which
# certificate renewal depends on. The deployed copy holds the origin secret.
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Never rewrite the public API.
  RewriteRule ^api/ - [L]

  # 2. Existing files and directories always win (hashed assets, favicon,
  #    robots.txt, sitemap.xml, og-image).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Client-side routing fallback.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Only /assets/ is content-fingerprinted by Vite, so only /assets/ may be
  # immutable. A file in public/ keeps its name across deploys, and marking it
  # immutable pins whatever a browser fetched first for a year — which is how a
  # replaced dashboard image stayed old in returning browsers.
  <FilesMatch "\.(?:js|css|woff2?|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
  </FilesMatch>

  # Everything else static — icons, the Open Graph image, anything a future
  # public/ file adds — gets a day, so a replacement at the same URL reaches
  # visitors and the CDN within a day instead of never.
  <FilesMatch "\.(?:js|css|woff2?|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=86400" "expr=%{REQUEST_URI} !~ m#^/assets/#"
  </FilesMatch>

  # The HTML shell must be revalidated so new deploys are picked up.
  <FilesMatch "\.(?:html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # -------------------------------------------------------------------------
  # SECURITY HEADERS — every response in this tree, across the whole site.
  #
  # `always` rather than `set`: `set` is skipped for the error documents Apache
  # generates itself (403, 404, 500), which is exactly where a header check
  # otherwise fails. /api/ overrides these values in its own .htaccess.
  #
  # The policy has no 'unsafe-inline' and no wildcard source. index.html does
  # carry one inline <script type="application/ld+json"> block, but that is a
  # data block and not executable script, so script-src 'self' does not block
  # it and no hash or nonce is needed. Inline style attributes were removed
  # from both HTML documents, so style-src needs no exception either.
  # -------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By

  # HSTS only on a TLS response: sent over plain HTTP it is ignored, and a
  # browser that has seen `max-age=0` keeps HSTS disabled for that host.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # Cookies emitted by this origin get the flags whether or not the script that
  # set them remembered. `edit` appends only when the flag is absent, so a
  # cookie that is already configured correctly is left exactly as it is.
  Header always edit Set-Cookie "^(?i)(?!.*;\s*httponly)(.*)$" "$1; HttpOnly"
  Header always edit Set-Cookie "^(?i)(?!.*;\s*secure)(.*)$" "$1; Secure" "expr=%{HTTPS} == 'on'"
  Header always edit Set-Cookie "^(?i)(?!.*;\s*samesite)(.*)$" "$1; SameSite=Lax"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
