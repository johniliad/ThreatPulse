# ThreatPulse — static frontend (React + Vite) deployed on Apache / cPanel.
#
# The PHP API lives in /api/cti/v1/ and is served by PHP directly: it must
# never be rewritten to index.html, and its own response headers (set in PHP)
# are deliberately left untouched here.

# ---------------------------------------------------------------------------
# CLOUDFLARE-ONLY ACCESS — always-on requirement.
# See deployment/ORIGIN_RESTRICTION.md.
#
# Cloudflare injects X-Origin-Secret on every request it forwards to this
# origin, using a Transform Rule ("Set static", which overwrites any value the
# visitor sent, so a client cannot supply its own). A request that arrives
# without the exact value did not come through Cloudflare and is refused here,
# before the SPA rewrite below can run.
#
# The value compared below is a build-time placeholder. It is replaced by
# deployment/stamp-origin-secret.mjs, which writes the stamped copy into
# dist/.htaccess; this tracked file always keeps the placeholder. A hex value
# here means the stamp went to the wrong file and the build is wrong.
#
# Deliberately OUTSIDE <IfModule mod_rewrite.c>: mod_rewrite is present on this
# host, and a guard would turn a missing module into an open site instead of a
# 500. A security control fails closed — the same reasoning as api/.htaccess.
#
# The ACME challenge path is exempt so cPanel AutoSSL can validate the domain
# without being routed through Cloudflare. It serves nothing worth hiding.
# ---------------------------------------------------------------------------
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP:X-Origin-Secret} !^__CF_ORIGIN_SECRET__$
RewriteRule ^ - [F,L]

# Apache's shipped configuration already denies .ht* files; stating the rule
# here makes the guarantee local to this file rather than inherited from the
# host. The (?!well-known) lookahead keeps the ACME path reachable, which
# certificate renewal depends on. The deployed copy holds the origin secret.
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Never rewrite the public API.
  RewriteRule ^api/ - [L]

  # 2. Existing files and directories always win (hashed assets, favicon,
  #    robots.txt, sitemap.xml, og-image).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Client-side routing fallback.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints every build asset, so they can be cached indefinitely.
  <FilesMatch "\.(?:js|css|woff2?|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Except the favicon, which is served from a fixed path and is not
  # fingerprinted: an immutable cache would pin a corrected icon in returning
  # browsers for a year.
  <FilesMatch "^favicon\.(?:ico|png|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # The HTML shell must be revalidated so new deploys are picked up.
  <FilesMatch "\.(?:html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers for static responses only (never for .php, which sets
  # its own headers).
  <FilesMatch "\.(?:html|js|css|svg|txt|xml)$">
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "DENY"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  </FilesMatch>

  # Optional hardening — enable after confirming the site still works:
  # Header set Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
