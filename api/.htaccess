# ThreatPulse — access control for the API tree.
#
# Two different requirements, and only one of them is a restriction:
#
#   PUBLIC      every read endpoint, the discovery index and this documentation
#               page. The React frontend calls /api/cti/v1/* directly from the
#               visitor's browser, so these have to accept anyone or the site
#               stops working for the public.
#
#   RESTRICTED  publish.php, the write endpoint the pipeline POSTs to. Reachable
#               only from the networks listed below.
#
#   DENIED      db.php, which is a library the endpoints include server-side and
#               never something that should be served as a URL.
#
# The allowlist:
#
#   Require ip           private ranges (10/8, 192.168/16, 172.20/16)
#   Require forward-dns  the home FortiGate's dynamic DNS name
#
# forward-dns is the right provider for a dynamic address, not `Require host`:
# `host` matches on reverse DNS, a PTR lookup the DDNS provider does not
# maintain, while forward-dns resolves the name and compares the result to the
# client address. Apache documents it as the provider for clients "which use a
# dynamic DNS service". It requires httpd 2.4.19 or later.
#
# mod_authz_core is a Base module of httpd 2.4, so nothing here is wrapped in
# <IfModule>. That is deliberate: an <IfModule> guard would fail open and serve
# the write endpoint to the world, and a security control should fail closed.

Options -Indexes
# `index.php` first: /api/cti/v1/ has no index.html, so it must resolve to the
# discovery script. With only `index.html` here the directory request answered
# 403, which is what clients that follow the documented base URL hit.
# The api/ root still serves its human-readable index.html (no index.php there).
DirectoryIndex index.php index.html

# ---------------------------------------------------------------------------
# CLOUDFLARE-ONLY ACCESS — always-on requirement.
# See deployment/ORIGIN_RESTRICTION.md.
#
# Every request under /api/ must carry the X-Origin-Secret that Cloudflare
# injects with a Transform Rule ("Set static", which overwrites a
# visitor-supplied value). This block is required in *this* file, not only in
# the web-root .htaccess: mod_rewrite rules in a parent directory are not
# inherited by a child directory that has its own .htaccess
# (RewriteOptions Inherit is off by default), so the root rule does not cover
# /api/ at all.
#
# The value compared below is a build-time placeholder. It is replaced by
# deployment/stamp-origin-secret.mjs, which writes the deployable copy to
# deployment/build/api/.htaccess; this tracked file always keeps the placeholder.
#
# This runs in the fixup phase, i.e. after the <Files "publish.php"> allowlist
# below has already granted or refused the request. The two are compatible:
#   disallowed address            -> 403 (authz)
#   allowed address, no token     -> 401 (PHP ran)
#   any address, no CF header     -> 403 (this rule)
# so the self-check in the block at the end of this file still holds.
#
# No <IfModule> guard: it would fail open (see the note at the top).
# ---------------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTP:X-Origin-Secret} !^__CF_ORIGIN_SECRET__$
RewriteRule ^ - [F,L]

# Serve the discovery document at the canonical URL without a redirect.
#
# mod_dir answers a request for the directory without a trailing slash with a
# 301 that carries a generated HTML body; mod_rewrite's per-directory rules run
# before mod_dir's fixup, so resolving the URL here answers it directly. The
# request never reaches PHP with a trailing-slash form it did not ask for, and
# there is no redirect body at all. The gated rule above still runs first, so an
# unauthorised request is refused before this.
RewriteRule ^cti/v1$ cti/v1/index.php [L]

# Apache's shipped configuration already denies .ht* files; stating the rule
# here makes the guarantee local to this file rather than inherited from the
# host. The (?!well-known) lookahead keeps the ACME path reachable, which
# certificate renewal depends on. The deployed copy holds the origin secret.
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Public: the read API, the discovery index and this page. Stated explicitly
# rather than left to the server default, so that the exception below is visible
# next to what it is an exception to.
Require all granted

# Restricted: the pipeline's write endpoint.
#
# A <Files> section carries its own authorization, which applies in place of the
# directory directive above for the files it matches, so this is a genuine
# restriction and not an addition to a broader grant. <Files> matches the
# basename at any depth, so /api/cti/v1/publish.php is covered.
<Files "publish.php">
    <RequireAny>
        Require ip 10.0.0.0/8
        Require ip 192.168.0.0/16
        Require ip 172.20.0.0/16
        Require forward-dns johniliadotefiber.fortiddns.com
    </RequireAny>
</Files>

# Denied: db.php and http.php are libraries the endpoints include server-side.
# Requesting either as a URL returns an empty body today, and nothing should be
# able to try.
<FilesMatch "^(?:db|http)\.php$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# SECURITY HEADERS — the single source for the whole /api/ tree.
#
# The PHP endpoints do not set these themselves (see api/cti/v1/http.php):
# `Header always` also covers responses Apache generates without running PHP —
# a denied publish.php is a 403 from mod_authz_core, not from PHP — and it
# keeps one copy of each value instead of two that can drift apart.
#
# The CSP allows a same-origin stylesheet for this tree's documentation page
# (docs.css) and nothing else; the JSON endpoints load no subresources at all.
# It has no 'unsafe-inline' and no wildcard source.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always unset X-Powered-By

    # HSTS only on a TLS response: sent over plain HTTP it is ignored, and a
    # browser that has seen `max-age=0` keeps HSTS disabled for that host.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

    # A session cookie must not be readable from script, must not travel over
    # plain HTTP and must not ride along on cross-site requests. `edit` appends
    # a flag only when it is missing, so a correct cookie is left untouched.
    Header always edit Set-Cookie "^(?i)(?!.*;\s*httponly)(.*)$" "$1; HttpOnly"
    Header always edit Set-Cookie "^(?i)(?!.*;\s*secure)(.*)$" "$1; Secure" "expr=%{HTTPS} == 'on'"
    Header always edit Set-Cookie "^(?i)(?!.*;\s*samesite)(.*)$" "$1; SameSite=Lax"
</IfModule>

# ---------------------------------------------------------------------------
# VERIFYING IT WORKS
#
# The two endpoints answer with different statuses, which makes the rule
# self-checking: a blocked request never reaches PHP, so it cannot return 401.
#
#   from a DISALLOWED address:
#     POST /api/cti/v1/publish.php   -> 403  (Apache refused it)
#
#   from an ALLOWED address, without a token:
#     POST /api/cti/v1/publish.php   -> 401  (PHP ran and rejected the caller)
#
#   from ANYWHERE:
#     GET  /api/cti/v1/threats.php   -> 200  (still public)
#
# A 401 from a disallowed address means the restriction is NOT taking effect.
# A 403 on threats.php means the public grant above is not taking effect either.
#
# IF forward-dns IS REJECTED
# Older builds than httpd 2.4.19 have no forward-dns provider. The symptom is a
# 500 on the whole API, with "Invalid command 'Require'" or "unknown provider" in
# the error log, because a parse error takes the directory down with it. Pin the
# address instead, and re-check it whenever the DDNS name changes:
#
#     Require ip 85.75.30.118
#
# Check the current answer with:  nslookup johniliadotefiber.fortiddns.com
# ---------------------------------------------------------------------------

